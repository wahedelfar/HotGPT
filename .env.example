# Add these values later through the WebDev protected secrets flow.
NEXA_PROVIDER_BASE_URL=
NEXA_PROVIDER_API_KEY=
NEXA_PROVIDER_MODEL=
# Optional: the provider's actual model ID for Beast Pro (falls back to NEXA_PROVIDER_MODEL if unset)
NEXA_PROVIDER_BEAST_MODEL=
# Optional fallback provider model configuration (when OpenRouter is enabled)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BEAST_MODEL=

# Optional payment/admin settings for the token wallet
PAYPAL_PAYMENT_URL=
HOTGPT_ADMIN_EMAILS=your-admin-email@example.com
# Optional live web search providers (configure one or both in Vercel)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Required for authenticated members and token billing
DATABASE_URL=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
ADMIN_SESSION_SECRET=
ADMIN_INITIAL_PASSWORD=
