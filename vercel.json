{
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/auth",
      "destination": "/api/billing?action=auth"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/**/*.ts",
      "maxDuration": 60
    }
  }
}
